# 系統與 Office 的暫存檔
~$*
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.venv/
DATA/
*.sqlite3

# 工具自己的設定（不推）
.claude/settings.local.json
.codex/

# 研究資料不進這裡（原始資料留在原本的地方；這裡只放算好的數字與去識別後的文字）
*.sav
*.zsav
*.spv
*.xlsx
*.xls
*.csv
*.mp3
*.m4a
*.wav
*.mp4

# 寫信用的 .eml（可能含個資）只准放這裡，用完就刪
cache/

# gws 的登入設定檔不進 git
client_secret*.json
